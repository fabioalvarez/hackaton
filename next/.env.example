# Copy this file to .env (`make env` does it) and adjust the values.
# Do not put secrets in .env.example: this file is committed to the repository.

# Data file (`make up` sets it to /data/orders.json inside the container)
DATA_PATH=data/orders.json

# Port the API listens on
PORT=8080

# Service name shown by GET /
SERVICE_NAME=Next

# Log level: debug, info, warning, error (debug also shows the successful /health requests)
LOG_LEVEL=info

# Instance identifier. If omitted, the host name is used.
# INSTANCE_ID=local
